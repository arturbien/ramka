{
  "name": "ramka-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Monorepo for ramka — an unstyled primitive image-gallery library for React — and its documentation site.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:build": "pnpm --filter @ramka/react --filter @ramka/svelte build && pnpm --filter docs build",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,mjs,cjs}\"",
    "docs:api": "pnpm --filter docs docs:api",
    "docs:api:check": "pnpm --filter docs docs:api:check",
    "docs:excerpts": "pnpm --filter docs docs:excerpts",
    "docs:excerpts:check": "pnpm --filter docs docs:excerpts:check",
    "docs:llms": "pnpm --filter docs docs:llms",
    "docs:llms:check": "pnpm --filter docs docs:llms:check",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "license:check": "node scripts/check-license-copies.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "pkg-pr-new": "^0.0.88",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "turbo": "^2.10.10",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  }
}
