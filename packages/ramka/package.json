{
  "name": "@ramka/react",
  "version": "0.0.0",
  "description": "Unstyled, accessible image gallery primitives for React. (\"ramka\" — Polish for \"frame\".)",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturbien/ramka.git",
    "directory": "packages/ramka"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lightbox": {
      "types": "./dist/lightbox/lightbox.d.ts",
      "import": "./dist/lightbox/lightbox.js",
      "require": "./dist/lightbox/lightbox.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "sbom.cdx.json"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/fix-dist-specifiers.mjs",
    "dev": "trap 'kill 0' EXIT; tsc -p tsconfig.build.json --watch --preserveWatchOutput & tsup --watch --onSuccess 'node scripts/fix-dist-specifiers.mjs'",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "react",
    "image-gallery",
    "gallery",
    "carousel",
    "lightbox",
    "primitives",
    "headless",
    "unstyled",
    "accessible"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
